VITE_DIDA_CLIENT_ID=your_client_id_here
VITE_DIDA_CLIENT_SECRET=your_client_secret_here

# TickTick (international version) OAuth credentials
# Get from: https://developer.ticktick.com/manage
VITE_TICKTICK_CLIENT_ID=your_ticktick_client_id_here
VITE_TICKTICK_CLIENT_SECRET=your_ticktick_client_secret_here

# Todoist OAuth credentials
# Get from: https://developer.todoist.com/appconsole.html
VITE_TODOIST_CLIENT_ID=your_todoist_client_id_here
VITE_TODOIST_CLIENT_SECRET=your_todoist_client_secret_here

# AI Buddy 本地默认配置（仅 dev 模式生效，用户未配置时兜底）
# Kimi 示例：
VITE_BUDDY_BASE_URL=https://api.moonshot.cn/v1
VITE_BUDDY_API_KEY=your_kimi_api_key_here
VITE_BUDDY_MODEL=kimi-k2-0905-preview

# 开发用：dev 模式自动灌入 90 天假番茄数据，省去手动敲控制台命令
# 仅在 focus_stats 为空时灌入；想重灌先在 DevTools 清空该 key。生产构建会被 tree-shaken
VITE_DEV_SEED_FOCUS_STATS=true
