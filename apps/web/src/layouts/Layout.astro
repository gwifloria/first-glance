---
import '../styles/global.css'

interface Props {
  title: string
  lang?: 'zh' | 'en'
  description?: string
}

const { title, lang = 'zh', description } = Astro.props

const defaultDescriptions = {
  zh: '将新标签页变成专注仪表盘，一眼看到今日重要任务。与滴答清单无缝同步。',
  en: 'Transform your new tab into a focused dashboard. See today\'s important tasks at a glance. Seamlessly synced with TickTick.',
}

const pageDescription = description || defaultDescriptions[lang]
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en'
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Nunito:wght@300;400;600;700;800&family=Noto+Sans+SC:wght@300;400;500;700&family=Noto+Serif+SC:wght@400;500;600&family=ZCOOL+XiaoWei&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-background text-stone overflow-x-hidden">
    <slot />
  </body>
</html>
