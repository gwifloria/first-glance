---
import Layout from '../../layouts/Layout.astro'
import { roadmap } from '../../data/roadmap'

const chromeStoreUrl = 'https://chromewebstore.google.com/detail/first-glance/lbcklgfmlcjjiclnlhbpmpeaeopjkeop'

// Theme colors for the gallery
const themes = [
  { name: 'Milk', bg: '#fcfcfc', accent: '#f0f0f0' },
  { name: 'Beige', bg: '#f7f1e4', accent: '#e2ddd3' },
  { name: 'Pink', bg: '#fcfaf9', accent: '#d4a5a5' },
  { name: 'Blue', bg: '#e8f0f5', accent: '#a2c1c0' },
  { name: 'Dark', bg: '#292524', accent: '#44403c' },
]
---

<Layout title="Introduction - First Glance" lang="en">
  <!-- Background Texture -->
  <div class="fixed inset-0 paper-texture pointer-events-none z-0"></div>

  <!-- Pink decorative blob -->
  <div class="fixed top-[-100px] right-[-100px] w-[500px] h-[500px] bg-pink-light rounded-full mix-blend-multiply filter blur-3xl opacity-40 pointer-events-none z-0"></div>

  <!-- Navigation -->
  <nav class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-md border-b border-border">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-9 h-9 relative flex items-center justify-center bg-white rounded-xl shadow-sm border border-border group-hover:rotate-3 transition-transform">
          <div class="absolute inset-2 border-2 border-pink rounded-full border-dashed animate-spin-slow opacity-60"></div>
          <div class="w-2.5 h-2.5 bg-pink rounded-full"></div>
        </div>
        <span class="font-serif font-bold text-lg tracking-tight text-text">First Glance</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="#story" class="text-sm font-bold text-text-muted hover:text-text transition-colors">Story</a>
        <a href="#features" class="text-sm font-bold text-text-muted hover:text-text transition-colors">Features</a>
        <a href="#chill-mode" class="text-sm font-bold text-text-muted hover:text-text transition-colors">Chill Mode</a>
        <a href="#themes" class="text-sm font-bold text-text-muted hover:text-text transition-colors">Themes</a>
        <a href="/first-glance/en/changelog" class="text-sm font-bold text-text-muted hover:text-text transition-colors">Changelog</a>
        <a href="/first-glance/" class="text-sm font-bold text-text-muted hover:text-text transition-colors">中文</a>
      </div>

      <a
        href={chromeStoreUrl}
        target="_blank"
        class="bg-text text-background px-5 py-2 rounded-lg text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center gap-2"
      >
        <span>Install</span>
        <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </nav>

  <!-- Section 1: Hero -->
  <header class="snap-section relative pt-24 pb-16 px-6 flex items-center overflow-hidden bg-background">
    <div class="max-w-7xl mx-auto w-full grid md:grid-cols-2 gap-12 items-center">
      <!-- Left: Copy -->
      <div class="relative z-10 max-w-xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white shadow-sm border border-border mb-8">
          <span class="w-2 h-2 rounded-full bg-pink"></span>
          <span class="text-text-muted text-xs font-bold tracking-widest uppercase">New Tab Extension</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-serif font-medium mb-6 leading-tight text-text">
          Start your day<br/>
          <span class="text-pink">with focus.</span>
        </h1>

        <p class="text-lg md:text-xl text-text-muted mb-10 leading-relaxed">
          Transform your new tab into a mindful digital notebook.<br class="hidden md:block" />
          Manage tasks, block distractions, and find your flow in a paper-like space.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={chromeStoreUrl}
            target="_blank"
            class="px-8 py-4 bg-text text-background rounded-xl font-bold shadow-xl hover:-translate-y-1 transition-transform flex items-center justify-center gap-3"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 6.627 5.373 12 12 12s12-5.373 12-12C24 5.373 18.627 0 12 0zm0 19.5c-4.142 0-7.5-3.358-7.5-7.5S7.858 4.5 12 4.5s7.5 3.358 7.5 7.5-3.358 7.5-7.5 7.5z"/>
            </svg>
            <span>Add to Chrome</span>
            <span class="opacity-50 font-normal text-xs">— It's Free</span>
          </a>
        </div>
      </div>

      <!-- Right: Focus View Mockup -->
      <div class="relative z-0 animate-float">
        <!-- Browser Shell -->
        <div class="relative bg-white rounded-2xl shadow-xl border border-border overflow-hidden">
          <div class="bg-background rounded-xl overflow-hidden aspect-[16/10] relative flex">

            <!-- Sidebar Mockup -->
            <div class="hidden sm:flex w-1/3 bg-background flex-col p-5 gap-4 border-r border-border-light">
              <!-- Header -->
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-border-light rounded-full"></div>
                <div class="w-20 h-2 bg-border rounded-full"></div>
              </div>

              <!-- List Items -->
              <div class="space-y-2">
                <div class="h-9 w-full bg-white rounded-lg shadow-sm border border-border-light flex items-center px-3 gap-3">
                  <div class="w-4 h-4 rounded-full border-2 border-pink"></div>
                  <div class="w-12 h-2 bg-text/20 rounded-full"></div>
                  <div class="ml-auto bg-pink text-white text-[9px] px-1.5 rounded-full">8</div>
                </div>
                <div class="h-9 w-full flex items-center px-3 gap-3 text-text-muted">
                  <div class="w-4 h-4 rounded-full border-2 border-border"></div>
                  <div class="w-16 h-2 bg-border rounded-full"></div>
                </div>
                <div class="h-9 w-full flex items-center px-3 gap-3 text-text-muted">
                  <div class="w-4 h-4 rounded-full border-2 border-border"></div>
                  <div class="w-14 h-2 bg-border rounded-full"></div>
                </div>
              </div>

              <!-- Lists label -->
              <div class="mt-2 text-[9px] font-bold text-pink uppercase tracking-wider px-1">Lists</div>
              <div class="space-y-1">
                <div class="flex items-center px-3 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-pink"></div>
                  <div class="w-14 h-2 bg-border rounded-full"></div>
                </div>
                <div class="flex items-center px-3 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-mint"></div>
                  <div class="w-10 h-2 bg-border rounded-full"></div>
                </div>
              </div>
            </div>

            <!-- Main Content Mockup (Focus View) -->
            <div class="flex-1 bg-white relative flex flex-col items-center justify-center p-6">
              <!-- Clock -->
              <div class="text-center mb-6">
                <div class="text-text font-serif text-5xl md:text-6xl mb-1">09:30</div>
                <div class="text-text-light text-xs font-bold uppercase tracking-widest">Good Morning</div>
              </div>

              <!-- The Task Card -->
              <div class="w-full max-w-xs bg-background border border-border-light p-4 rounded-xl flex items-center gap-4 shadow-sm">
                <div class="w-6 h-6 rounded-lg border-2 border-pink flex-shrink-0"></div>
                <div class="text-lg font-serif text-text">Plan Weekly Goals</div>
              </div>

              <!-- Hint -->
              <div class="mt-4 text-pink font-serif text-sm">Press Enter to complete</div>
            </div>
          </div>
        </div>

        <!-- Decorative Blobs -->
        <div class="absolute -top-8 -right-8 w-24 h-24 bg-pink-light rounded-full mix-blend-multiply filter blur-2xl opacity-60 animate-pulse-soft"></div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-mint/30 rounded-full mix-blend-multiply filter blur-2xl opacity-60"></div>
      </div>
    </div>
  </header>

  <!-- Section: Why First Glance -->
  <section id="story" class="snap-section py-20 px-6 bg-white flex items-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif font-medium text-text mb-12 text-center">
        Why First Glance?
      </h2>

      <div class="space-y-6 text-lg text-text-muted leading-relaxed">
        <p>
          I use <span class="text-pink font-medium">TickTick</span> for all my tasks.
        </p>

        <p>
          I also like <span class="text-text font-medium">Momentum</span>-style new tab pages—open a tab, see a clock and today's task. Clean.
        </p>

        <p>
          But it has its own task system. Using it means <span class="text-pink font-medium">maintaining two sets of data</span>, or messing with sync.
        </p>

        <blockquote class="border-l-4 border-pink pl-6 py-2 my-8 bg-pink-bg/30 rounded-r-xl">
          <p class="font-serif text-text">
            I just want to manage tasks in one place.
          </p>
        </blockquote>

        <p>
          So I built First Glance: <span class="text-text font-medium">reads directly from TickTick, no copying, no syncing.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: Features -->
  <section id="features" class="snap-section py-20 px-6 bg-white flex items-center">
    <div class="max-w-6xl mx-auto w-full">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-serif font-medium text-text mb-4">Core Features</h2>
        <p class="text-text-muted text-lg">A new tab page designed for focus</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Feature 1: Focus/List Views -->
        <div class="bg-background p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
          <div class="w-12 h-12 bg-pink-bg rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform border border-border-pink">
            <svg class="w-6 h-6 text-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold font-serif mb-2 text-text">Focus / List Views</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Focus mode shows only the current task. List mode displays all todos. Switch instantly to match your workflow.
          </p>
        </div>

        <!-- Feature 2: Task Management -->
        <div class="bg-background p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
          <div class="w-12 h-12 bg-beige rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform border border-beige-border">
            <svg class="w-6 h-6 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold font-serif mb-2 text-text">Task Management</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            View, add, complete, and delete tasks quickly. Smart grouping by Today/Tomorrow helps you stay on track.
          </p>
        </div>

        <!-- Feature 3: Pomodoro Timer -->
        <div class="bg-background p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
          <div class="w-12 h-12 bg-pink-bg rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform border border-border-pink">
            <svg class="w-6 h-6 text-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold font-serif mb-2 text-text">Pomodoro Timer</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Classic 25-minute focus + 5-minute break rhythm. Syncs across tabs so you never lose your timer.
          </p>
        </div>

        <!-- Feature 4: TickTick Sync -->
        <div class="bg-background p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
          <div class="w-12 h-12 bg-mint/20 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform border border-mint/30">
            <svg class="w-6 h-6 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold font-serif mb-2 text-text">TickTick Sync</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Connect your TickTick account for automatic task sync. Manage from new tab, changes sync instantly.
          </p>
        </div>

        <!-- Feature 5: Guest Mode -->
        <div class="bg-background p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
          <div class="w-12 h-12 bg-border-light rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform border border-border">
            <svg class="w-6 h-6 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold font-serif mb-2 text-text">Guest Mode</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            No login required. Start instantly with local storage. Up to 3 tasks, perfect for a quick trial.
          </p>
        </div>

        <!-- Feature 6: Multiple Themes -->
        <div class="bg-background p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
          <div class="w-12 h-12 bg-pink-bg rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform border border-border-pink">
            <svg class="w-6 h-6 text-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold font-serif mb-2 text-text">5 Themes</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Milk, Beige, Pink, Blue, and Dark—each carefully designed. Find the style that fits you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Coming Soon / Roadmap -->
  <section id="roadmap" class="snap-section py-20 px-6 bg-background flex items-center">
    <div class="max-w-6xl mx-auto w-full">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white shadow-sm border border-border mb-6">
          <span class="w-2 h-2 rounded-full bg-mint animate-pulse"></span>
          <span class="text-text-muted text-xs font-bold tracking-widest uppercase">Coming Soon</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-serif font-medium text-text mb-4">More Task Sources</h2>
        <p class="text-text-muted text-lg">We're working on supporting more task management tools</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {roadmap.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-border hover:shadow-lg transition-shadow group">
            <div class="flex items-start justify-between mb-4">
              <div class="text-3xl">{item.icon}</div>
              <span class={`px-3 py-1 text-xs font-bold rounded-full ${
                item.status === 'coming-soon'
                  ? 'bg-pink-bg text-pink border border-border-pink'
                  : item.status === 'in-progress'
                  ? 'bg-blue-50 text-blue-600 border border-blue-200'
                  : 'bg-border-light text-text-muted border border-border'
              }`}>
                {item.status === 'coming-soon' ? 'Coming Soon' : item.status === 'in-progress' ? 'In Progress' : 'Planned'}
              </span>
            </div>
            <h3 class="text-lg font-bold font-serif mb-2 text-text">{item.title.en}</h3>
            <p class="text-sm text-text-muted leading-relaxed">{item.description.en}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Chill Mode (Dark Background) -->
  <section id="chill-mode" class="snap-section py-20 px-6 bg-text text-background relative overflow-hidden flex items-center">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10 paper-texture"></div>

    <div class="max-w-6xl mx-auto w-full grid md:grid-cols-2 gap-16 items-center relative z-10">
      <!-- Text -->
      <div>
        <div class="w-12 h-12 bg-pink rounded-xl flex items-center justify-center mb-6 text-text">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
        </div>
        <h3 class="text-3xl md:text-4xl font-serif font-bold text-pink mb-4">Chill Mode</h3>
        <p class="text-lg text-background/70 mb-6 leading-relaxed">
          Can't stop scrolling? We've got you.<br/>
          First Glance intercepts distracting sites with a mindful pause screen.
        </p>
        <div class="bg-white/5 p-6 rounded-xl border border-white/10">
          <p class="italic font-serif text-lg mb-4 text-pink">"Seriously? This site? Now?"</p>
          <div class="flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-pink">
            <span>Hold to Unlock</span>
            <div class="h-1 flex-1 bg-white/20 rounded-full overflow-hidden">
              <div class="h-full w-1/3 bg-pink transition-all duration-1000"></div>
            </div>
          </div>
          <p class="text-xs text-background/50 mt-3">
            Hold for 10 seconds to unlock. Pauses blocking for 15 minutes. Long enough to think twice.
          </p>
        </div>
      </div>

      <!-- Visual: Blocked Page Mockup -->
      <div class="relative flex justify-center">
        <div class="w-80 bg-background rounded-2xl p-8 text-center text-text shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500">
          <div class="text-5xl font-black mb-4">( ￣^￣ )</div>
          <h4 class="text-2xl font-serif font-bold mb-2">Access Denied</h4>
          <p class="text-text-muted text-sm mb-8">I'm blocking this for your own good.</p>

          <button class="w-full py-3 bg-text text-background rounded-full font-bold shadow-lg flex items-center justify-center gap-2 cursor-default">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Fine, I'll focus
          </button>
        </div>

        <!-- Decorative tape -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-20 h-6 tape rounded"></div>
      </div>
    </div>
  </section>

  <!-- Section 4: Themes Gallery -->
  <section id="themes" class="snap-section py-20 px-6 bg-background flex items-center">
    <div class="max-w-4xl mx-auto w-full text-center">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-text mb-4">Pick Your Style</h2>
      <p class="text-text-muted text-lg mb-12">5 carefully designed themes to match your mood</p>

      <div class="flex flex-wrap justify-center gap-8 md:gap-12">
        {themes.map((theme, index) => (
          <div class="group cursor-pointer">
            <div
              class={`w-20 h-20 md:w-24 md:h-24 rounded-full shadow-lg mb-3 group-hover:scale-110 transition-transform relative overflow-hidden ${index === 2 ? 'border-4 border-pink' : 'border-4 border-border'}`}
              style={`background-color: ${theme.bg}`}
            >
              <div
                class="absolute bottom-0 left-0 w-full h-1/2"
                style={`background-color: ${theme.accent}`}
              ></div>
            </div>
            <h4 class="font-bold text-text text-sm">{theme.name}</h4>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Footer -->
  <footer class="bg-white border-t border-border py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2 opacity-50">
        <div class="w-5 h-5 rounded-full border border-current flex items-center justify-center">
          <div class="w-1.5 h-1.5 bg-current rounded-full"></div>
        </div>
        <span class="font-serif font-bold text-sm text-text">First Glance</span>
      </div>

      <div class="flex gap-6 text-sm font-medium opacity-60">
        <a href="https://github.com/gwifloria/first-glance/issues" target="_blank" class="hover:opacity-100 transition-opacity">Feedback</a>
        <a href="https://github.com/gwifloria/first-glance" target="_blank" class="hover:opacity-100 transition-opacity">GitHub</a>
        <a href="/first-glance/privacy" class="hover:opacity-100 transition-opacity">Privacy</a>
      </div>

      <div class="text-xs font-bold uppercase tracking-widest text-text/40">
        &copy; 2025 Wonderland
      </div>
    </div>
  </footer>
</Layout>
