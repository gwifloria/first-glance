---
import Layout from '../layouts/Layout.astro'
import { integrations } from '../data/integrations'

const chromeStoreUrl = 'https://chromewebstore.google.com/detail/first-glance/lbcklgfmlcjjiclnlhbpmpeaeopjkeop'

// Theme colors for the gallery
const themes = [
  { name: 'Milk', bg: '#fcfcfc', accent: '#f0f0f0', text: '#5d5555', pink: '#d4a5a5' },
  { name: 'Beige', bg: '#f7f1e4', accent: '#e2ddd3', text: '#6b5e53', pink: '#c9a96e' },
  { name: 'Pink', bg: '#fcfaf9', accent: '#faeaea', text: '#5d5555', pink: '#d4a5a5' },
  { name: 'Blue', bg: '#e8f0f5', accent: '#c8dce6', text: '#4a5c6a', pink: '#7ba7c2' },
  { name: 'Dark', bg: '#292524', accent: '#44403c', text: '#d6d3d1', pink: '#d4a5a5' },
]
---

<Layout title="产品介绍 - First Glance">
  <!-- Grid Background -->
  <div class="fixed inset-0 paper-texture pointer-events-none z-0"></div>

  <!-- Navigation — minimal: logo + CTA only -->
  <nav class="fixed top-0 w-full z-50 bg-cream/90 backdrop-blur-md">
    <div class="max-w-[1600px] mx-auto px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32 h-16 flex items-center justify-between">
      <a href="#" class="inline-flex items-center gap-2.5 px-5 py-2 bg-white rounded-full border-2 border-ink/15 shadow-sm hover:shadow-md transition-shadow rotate-[-1deg]">
        <img src="/first-glance/favicon.png" alt="First Glance" class="w-6 h-6 rounded-lg" />
        <span class="font-hand font-bold text-lg text-ink">FirstGlance</span>
      </a>

      <div class="flex items-center gap-3">
        <a href="/first-glance/en" class="px-3 py-1.5 text-sm font-bold text-ink-light hover:text-ink transition-colors rounded-full border border-ink/10 hover:border-ink/20">EN</a>
        <a
          href={chromeStoreUrl}
          target="_blank"
          class="bg-ink text-cream px-6 py-2.5 rounded-full text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center gap-2 rotate-[1deg]"
        >
          <span class="hidden sm:inline">安装扩展</span>
          <span class="sm:hidden">安装</span>
          <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <!-- Section 1: Hero -->
  <header id="hero" class="snap-section-hero relative px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32 overflow-hidden">
    <div class="max-w-[1600px] mx-auto w-full grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Copy -->
      <div class="relative z-10 max-w-xl lg:max-w-2xl">
        <!-- Washi tape decoration -->
        <div class="w-28 h-5 tape rounded mb-4 hidden lg:block"></div>
        <h1 class="text-5xl md:text-7xl lg:text-8xl xl:text-9xl font-hand font-bold mb-4 leading-[1.05] text-ink">
          First<br/>
          <span class="highlight">Glance.</span>
        </h1>

        <p class="text-xl md:text-2xl lg:text-3xl text-ink font-bold mb-2 leading-snug">
          为专注重新设计的新标签页。
        </p>
        <p class="text-lg md:text-xl text-ink-light mb-2 leading-relaxed">
          打开浏览器的一瞬间，只看今天最重要的事。
        </p>
        <p class="text-lg md:text-xl text-ink-light mb-8 leading-relaxed">
          <span class="underline-pink">没有广告。</span>&nbsp;&nbsp;<span class="underline-blue">没有杂乱。</span>&nbsp;&nbsp;只有专注。
        </p>

        <div class="flex flex-wrap items-center gap-6">
          <a
            href={chromeStoreUrl}
            target="_blank"
            class="px-8 py-4 bg-ink text-cream rounded-xl font-bold text-lg shadow-xl hover:-translate-y-1 transition-transform flex items-center justify-center gap-3"
          >
            <span>开始使用 — 免费</span>
          </a>

          <!-- Social proof -->
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-tape-pink/30 border-2 border-cream flex items-center justify-center text-xs">:)</div>
              <div class="w-8 h-8 rounded-full bg-tape-blue/30 border-2 border-cream flex items-center justify-center text-xs">^^</div>
              <div class="w-8 h-8 rounded-full bg-highlight/60 border-2 border-cream flex items-center justify-center text-xs">~</div>
            </div>
            <span class="text-sm text-ink-light font-hand">免费且开源</span>
          </div>
        </div>
      </div>

      <!-- Dashed arrow pointing to mockup -->
      <div class="hidden md:block absolute left-[48%] top-[65%] -translate-x-1/2 z-10">
        <svg width="80" height="60" viewBox="0 0 80 60" fill="none" class="text-ink/30">
          <path d="M5 5 C 30 5, 50 15, 65 40" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4" fill="none" stroke-linecap="round"/>
          <path d="M58 34 L66 42 L56 42" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Right: Focus View Mockup — tilted with glow -->
      <div class="relative z-0 rotate-[2deg] hover:rotate-0 transition-transform duration-500">
        <!-- Coffee doodle — top right -->
        <div class="hidden lg:block absolute -top-16 -right-8 z-10 opacity-30 rotate-[12deg]">
          <svg width="88" height="88" viewBox="0 0 64 64" fill="none">
            <path d="M12 20h28v22a10 10 0 01-10 10H22a10 10 0 01-10-10V20z" stroke="var(--color-tape-pink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M40 24h4a6 6 0 010 12h-4" stroke="var(--color-tape-pink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M20 8v6M26 6v8M32 8v6" stroke="var(--color-tape-pink)" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
          </svg>
        </div>
        <!-- Background glow -->
        <div class="absolute inset-0 bg-tape-blue rounded-full mix-blend-multiply blur-3xl opacity-20 scale-110"></div>

        <div class="relative bg-white rounded-[2rem] shadow-2xl border-[6px] border-white overflow-hidden">
          <!-- Camera notch -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-5 bg-ink/80 rounded-b-xl z-20"></div>

          <!-- Screen content with paper bg -->
          <div class="bg-cream aspect-[16/10] relative flex flex-col items-center justify-center p-8 overflow-hidden">
            <div class="absolute inset-0 mockup-grid"></div>

            <div class="relative z-10 text-center mb-8">
              <div class="text-ink font-hand text-7xl md:text-8xl font-bold mb-1">10:42</div>
              <div class="text-ink-light text-xl font-hand">早上好，创造者。</div>
            </div>

            <div class="relative z-10 w-full max-w-sm space-y-3">
              <div class="bg-white border border-border p-4 rounded-xl flex items-center gap-4 shadow-lg -rotate-1">
                <div class="w-7 h-7 rounded-md border-2 border-ink/30 flex-shrink-0"></div>
                <span class="text-lg font-bold text-ink font-hand">完成产品方案</span>
              </div>
              <div class="bg-white/80 border border-border-light p-3.5 rounded-xl flex items-center gap-4 shadow-sm rotate-1 opacity-60">
                <div class="w-6 h-6 rounded-md border-2 border-border flex-shrink-0"></div>
                <span class="text-base text-ink font-hand">遛狗</span>
              </div>
            </div>

            <!-- Focus sticker inside screen -->
            <div class="absolute bottom-4 right-4 w-14 h-14 bg-tape-pink rounded-full flex items-center justify-center text-white font-bold font-hand shadow-lg rotate-12 z-10">
              Focus!
            </div>
          </div>
        </div>

        <!-- Pencil decoration -->
        <div class="absolute -bottom-8 -right-8 hidden md:block">
          <div class="w-48 h-6 bg-yellow-400 rounded-full shadow-xl -rotate-45 border-2 border-yellow-500 relative">
            <div class="absolute right-0 w-10 h-6 bg-tape-pink rounded-r-full border-l-[3px] border-border"></div>
            <div class="absolute left-[-12px] w-0 h-0 border-t-[12px] border-t-transparent border-r-[20px] border-r-[#d4a574] border-b-[12px] border-b-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Section 2: 任务墙 (List View) -->
  <section id="planner" class="snap-section px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32 bg-cream relative overflow-hidden">
    <div class="absolute inset-0 paper-texture pointer-events-none opacity-40"></div>
    <div class="max-w-[1600px] mx-auto w-full grid md:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center relative z-10">
      <!-- Left: Mockup (Dark theme) -->
      <div class="relative order-2 md:order-1 rotate-[1.5deg] hover:rotate-0 transition-transform duration-500">
        <!-- Decorative stickers -->
        <div class="absolute -top-6 -right-6 w-12 h-12 bg-tape-blue/20 rounded-full flex items-center justify-center text-lg rotate-12 border-2 border-white shadow-sm z-10 hidden md:flex">📋</div>
        <div class="absolute -bottom-4 -left-4 w-10 h-10 bg-sticker-green/20 rounded-full flex items-center justify-center text-sm rotate-[-8deg] border-2 border-white shadow-sm z-10 hidden md:flex">✨</div>
        <!-- Backing layer for depth -->
        <div class="absolute -inset-3 bg-cream-dark/60 rounded-3xl rotate-[-2deg] shadow-[0_25px_70px_-15px_rgba(0,0,0,0.12)]"></div>
        <div class="relative bg-white rounded-2xl border border-border overflow-hidden shadow-[0_10px_30px_-10px_rgba(0,0,0,0.12)]">
          <div class="flex min-h-[400px]">
            <!-- Sidebar -->
            <div class="w-2/5 bg-cream-dark/30 p-4 border-r border-border">
              <div class="flex items-center gap-2 px-2 py-1.5 bg-white rounded-lg border border-border mb-4">
                <svg class="w-3.5 h-3.5 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <span class="text-[10px] text-ink-muted">搜索...</span>
              </div>

              <div class="text-[8px] font-bold text-ink-muted uppercase tracking-wider mb-2">智能清单</div>
              <div class="space-y-1">
                <div class="flex items-center justify-between px-2 py-1.5 bg-white rounded-lg shadow-sm border border-border">
                  <div class="flex items-center gap-2">
                    <svg class="w-3 h-3 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span class="text-[11px] font-bold text-ink">今天</span>
                  </div>
                  <span class="text-[10px] text-ink font-bold">4</span>
                </div>
                <div class="flex items-center justify-between px-2 py-1.5">
                  <div class="flex items-center gap-2">
                    <svg class="w-3 h-3 text-ink-light" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span class="text-[11px] text-ink-light">最近7天</span>
                  </div>
                  <span class="text-[10px] text-ink-muted">5</span>
                </div>
              </div>

              <div class="text-[8px] font-bold text-ink-muted uppercase tracking-wider mt-4 mb-2">清单</div>
              <div class="space-y-1">
                <div class="flex items-center px-2 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-tape-pink"></div>
                  <span class="text-[11px] text-ink-light">工作</span>
                </div>
                <div class="flex items-center px-2 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-tape-blue"></div>
                  <span class="text-[11px] text-ink-light">个人</span>
                </div>
                <div class="flex items-center px-2 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-sticker-green"></div>
                  <span class="text-[11px] text-ink-light">副业</span>
                </div>
              </div>
            </div>

            <!-- Task List -->
            <div class="flex-1 bg-white p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <div class="text-[8px] font-bold text-ink-muted uppercase tracking-wider">智能清单</div>
                  <div class="flex items-center gap-2">
                    <span class="text-lg font-bold text-ink">今天</span>
                    <span class="text-tape-pink text-xs font-bold">&#10038; 4</span>
                  </div>
                </div>
                <span class="text-ink-muted text-sm font-hand">18:19</span>
              </div>

              <div class="space-y-2.5">
                <div class="flex items-start gap-3 py-1">
                  <div class="w-4 h-4 mt-0.5 rounded-full border-2 border-tape-pink flex-shrink-0"></div>
                  <div>
                    <div class="text-sm font-bold text-ink">完成网站改版</div>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      <div class="w-1.5 h-1.5 rounded-full bg-tape-pink"></div>
                      <span class="text-[10px] text-tape-pink font-bold">#工作</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-start gap-3 py-1">
                  <div class="w-4 h-4 mt-0.5 rounded-full border-2 border-border flex-shrink-0"></div>
                  <div>
                    <div class="text-sm text-ink">给妈妈打电话</div>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      <div class="w-1.5 h-1.5 rounded-full bg-ink-muted"></div>
                      <span class="text-[10px] text-ink-muted">#个人</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-start gap-3 py-1">
                  <div class="w-4 h-4 mt-0.5 rounded-full border-2 border-border flex-shrink-0"></div>
                  <div>
                    <div class="text-sm text-ink">Review PR #42</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Text -->
      <div class="order-1 md:order-2">
        <div class="inline-block px-5 py-1.5 bg-tape-blue/20 text-ink font-bold text-sm rounded-full rotate-[-2deg] mb-6 border border-tape-blue/30">任务墙</div>
        <h3 class="text-3xl md:text-4xl lg:text-5xl font-hand font-bold text-ink mb-3">
          打开即用，任务已就位。
        </h3>
        <p class="text-lg lg:text-xl text-ink-light mb-6 leading-relaxed">
          <span class="highlight">滴答清单</span> & <span class="highlight">Todoist</span> 免费同步，零配置。
        </p>

        <!-- 集成工具 — 主视觉卡片 -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          {integrations.filter((item) => item.status === 'supported').map((item) => (
            <div class="relative bg-white rounded-2xl border-2 border-border p-4 shadow-sm hover:shadow-lg transition-shadow group">
              <span class="absolute -top-2.5 -right-2.5 px-2.5 py-0.5 text-[11px] font-black bg-highlight text-ink rounded-full shadow-md rotate-6 tracking-wide">FREE</span>
              <div class="flex items-center gap-3">
                {item.logo ? (
                  <img src={item.logo} alt={item.name.zh} class="w-8 h-8" />
                ) : (
                  <span class="text-2xl">{item.icon}</span>
                )}
                <div>
                  <div class="font-bold text-ink text-base">{item.name.zh}</div>
                  <div class="text-xs text-sticker-green font-bold flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    已接入
                  </div>
                </div>
              </div>
            </div>
          ))}
          {integrations.filter((item) => item.status !== 'supported').map((item) => (
            <div class="relative bg-cream/60 rounded-2xl border border-dashed border-border p-4">
              <div class="flex items-center gap-3">
                {item.logo ? (
                  <img src={item.logo} alt={item.name.zh} class="w-8 h-8 opacity-50" />
                ) : (
                  <span class="text-2xl opacity-50">{item.icon}</span>
                )}
                <div>
                  <div class="font-bold text-ink-light text-base">{item.name.zh}</div>
                  <div class="text-xs text-ink-muted font-bold">计划中</div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="space-y-2.5 text-sm">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-tape-pink flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-ink-light">智能日期分组（今天、明天、之后）</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-tape-pink flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-ink-light">不离开标签页，快速添加任务</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-tape-pink flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-ink-light">按项目或优先级筛选</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Chill Mode -->
  <section id="focus" class="snap-section px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32 bg-[#2C3E50] text-cream relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none bg-cream/[0.04]"></div>
    <div class="absolute inset-0 pointer-events-none opacity-[0.18]" style="background-image: radial-gradient(circle, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 20px 20px;"></div>
    <div class="max-w-[1600px] mx-auto w-full grid md:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">
      <!-- Left: Text + Mockup card -->
      <div>
        <div class="inline-block px-5 py-1.5 bg-sticker-green/20 text-sticker-green font-bold text-sm rounded-full rotate-[-2deg] mb-6 border-2 border-sticker-green/30">专注守护</div>
        <h3 class="text-3xl md:text-4xl lg:text-5xl font-hand font-bold text-cream mb-4">
          Chill Mode
        </h3>
        <p class="text-lg lg:text-xl text-cream/70 mb-8 leading-relaxed">
          控制不住刷手机？我们帮你。<br/>
          First Glance 会拦截分心网站，用一个「暂停一下」的页面提醒你。
        </p>

        <!-- Progress bar mockup -->
        <div class="bg-white/[0.07] border border-cream/10 rounded-2xl p-6 lg:p-7 backdrop-blur-sm shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]">
          <p class="text-cream font-bold mb-4 text-base">"真的要现在看这个？"</p>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-sm font-bold text-highlight shrink-0">长按解锁</span>
            <div class="hold-btn flex-1 h-3 bg-cream/10 rounded-full overflow-hidden">
              <div class="h-full w-1/3 bg-highlight rounded-full"></div>
            </div>
            <svg class="w-5 h-5 text-cream/50 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8h1a4 4 0 010 8h-1M3 8h14v9a4 4 0 01-4 4H7a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
          </div>
          <p class="text-xs text-cream/40 leading-relaxed">长按 10 秒解锁，暂停屏蔽 15 分钟。足够让你三思而后行。</p>
        </div>

        <!-- Sub-features -->
        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="flex items-center gap-3 bg-cream/[0.06] rounded-xl px-4 py-3 border border-cream/8">
            <span class="text-lg">🍅</span>
            <div>
              <div class="text-sm font-bold text-cream/90">番茄钟</div>
              <div class="text-xs text-cream/40">自定义时长</div>
            </div>
          </div>
          <div class="flex items-center gap-3 bg-cream/[0.06] rounded-xl px-4 py-3 border border-cream/8">
            <span class="text-lg">📊</span>
            <div>
              <div class="text-sm font-bold text-cream/90">专注统计</div>
              <div class="text-xs text-cream/40">可视化追踪</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Kaomoji card -->
      <div class="flex justify-center">
        <div class="relative group">
          <!-- Backing shadow layer -->
          <div class="absolute -inset-3 bg-cream/5 rounded-[2rem] rotate-3"></div>
          <!-- Tape decoration -->
          <div class="absolute -top-3 right-16 w-14 h-5 bg-tape-pink/40 rounded-sm rotate-6 z-20"></div>
          <!-- Card -->
          <div class="relative bg-cream rounded-2xl p-8 md:p-10 text-center shadow-[0_20px_60px_-15px_rgba(0,0,0,0.3)] text-ink overflow-hidden max-w-[400px] rotate-2 group-hover:rotate-0 transition-transform duration-300">
            <div class="absolute inset-0 paper-texture opacity-30"></div>
            <div class="relative z-10">
              <div class="text-5xl md:text-6xl font-black mb-5 text-ink/80">( ￣^￣ )</div>
              <h4 class="text-xl md:text-2xl font-hand font-bold mb-2 text-ink">访问已拦截</h4>
              <p class="text-ink-muted text-sm mb-6">我是为你好才拦的。</p>
              <div class="bg-ink text-cream rounded-full px-6 py-3 font-bold text-sm inline-flex items-center gap-2 shadow-lg">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
