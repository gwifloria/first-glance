---
import Layout from '../layouts/Layout.astro'
import { integrations } from '../data/integrations'

const chromeStoreUrl = 'https://chromewebstore.google.com/detail/first-glance/lbcklgfmlcjjiclnlhbpmpeaeopjkeop'

// Theme colors for the gallery
const themes = [
  { name: 'Milk', bg: '#fcfcfc', accent: '#f0f0f0', text: '#5d5555', pink: '#d4a5a5' },
  { name: 'Beige', bg: '#f7f1e4', accent: '#e2ddd3', text: '#6b5e53', pink: '#c9a96e' },
  { name: 'Pink', bg: '#fcfaf9', accent: '#faeaea', text: '#5d5555', pink: '#d4a5a5' },
  { name: 'Blue', bg: '#e8f0f5', accent: '#c8dce6', text: '#4a5c6a', pink: '#7ba7c2' },
  { name: 'Dark', bg: '#292524', accent: '#44403c', text: '#d6d3d1', pink: '#d4a5a5' },
]
---

<Layout title="产品介绍 - First Glance">
  <!-- Background Texture -->
  <div class="fixed inset-0 paper-texture pointer-events-none z-0"></div>

  <!-- Pink decorative blob -->
  <div class="fixed top-[-100px] right-[-100px] w-[500px] h-[500px] bg-pink-light rounded-full mix-blend-multiply filter blur-3xl opacity-40 pointer-events-none z-0"></div>

  <!-- Navigation -->
  <nav class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-md border-b border-border">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <img src="/first-glance/favicon.png" alt="First Glance" class="w-9 h-9 rounded-xl group-hover:rotate-3 transition-transform" />
        <span class="font-serif font-bold text-lg tracking-tight text-text">First Glance</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="#story" class="text-sm font-bold text-text-muted hover:text-text transition-colors">故事</a>
        <a href="#features" class="text-sm font-bold text-text-muted hover:text-text transition-colors">功能</a>
        <a href="#chill-mode" class="text-sm font-bold text-text-muted hover:text-text transition-colors">Chill Mode</a>
        <a href="#ai-buddy" class="text-sm font-bold text-text-muted hover:text-text transition-colors">AI Buddy</a>
        <a href="/first-glance/changelog" class="text-sm font-bold text-text-muted hover:text-text transition-colors">更新日志</a>
        <a href="/first-glance/en" class="text-sm font-bold text-text-muted hover:text-text transition-colors">EN</a>
        <a href="https://github.com/gwifloria/first-glance" target="_blank" class="text-text-muted hover:text-text transition-colors" title="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>

      <a
        href={chromeStoreUrl}
        target="_blank"
        class="bg-text text-background px-5 py-2 rounded-lg text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center gap-2"
      >
        <span class="hidden sm:inline">安装扩展</span>
        <span class="sm:hidden">安装</span>
        <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </nav>

  <!-- Section 1: Hero -->
  <header class="snap-section relative pt-24 pb-16 px-6 flex items-center overflow-hidden bg-background">
    <div class="max-w-7xl mx-auto w-full grid md:grid-cols-2 gap-12 items-center">
      <!-- Left: Copy -->
      <div class="relative z-10 max-w-xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white shadow-sm border border-border mb-8">
          <span class="w-2 h-2 rounded-full bg-pink"></span>
          <span class="text-text-muted text-xs font-bold tracking-widest uppercase">Chrome 新标签页扩展</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-serif font-medium mb-6 leading-tight text-text">
          专注，<br/>
          <span class="text-pink">始于一瞥。</span>
        </h1>

        <p class="text-lg md:text-xl text-text-muted mb-10 leading-relaxed">
          将新标签页变成专注的数字笔记本。<br class="hidden md:block" />
          管理任务、屏蔽干扰，在纸张般的界面中找到心流。
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={chromeStoreUrl}
            target="_blank"
            class="px-8 py-4 bg-text text-background rounded-xl font-bold shadow-xl hover:-translate-y-1 transition-transform flex items-center justify-center gap-3"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 6.627 5.373 12 12 12s12-5.373 12-12C24 5.373 18.627 0 12 0zm0 19.5c-4.142 0-7.5-3.358-7.5-7.5S7.858 4.5 12 4.5s7.5 3.358 7.5 7.5-3.358 7.5-7.5 7.5z"/>
            </svg>
            <span>添加到 Chrome</span>
            <span class="opacity-50 font-normal text-xs">— 免费</span>
          </a>
        </div>
      </div>

      <!-- Right: Focus View Mockup -->
      <div class="relative z-0 animate-float">
        <!-- Browser Shell -->
        <div class="relative bg-white rounded-2xl shadow-xl border border-border overflow-hidden">
          <div class="bg-background rounded-xl overflow-hidden aspect-[16/10] relative flex">

            <!-- Sidebar Mockup -->
            <div class="hidden sm:flex w-1/3 bg-background flex-col p-5 gap-4 border-r border-border-light">
              <!-- Header -->
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-border-light rounded-full"></div>
                <div class="w-20 h-2 bg-border rounded-full"></div>
              </div>

              <!-- List Items -->
              <div class="space-y-2">
                <div class="h-9 w-full bg-white rounded-lg shadow-sm border border-border-light flex items-center px-3 gap-3">
                  <div class="w-4 h-4 rounded-full border-2 border-pink"></div>
                  <div class="w-12 h-2 bg-text/20 rounded-full"></div>
                  <div class="ml-auto bg-pink text-white text-[9px] px-1.5 rounded-full">8</div>
                </div>
                <div class="h-9 w-full flex items-center px-3 gap-3 text-text-muted">
                  <div class="w-4 h-4 rounded-full border-2 border-border"></div>
                  <div class="w-16 h-2 bg-border rounded-full"></div>
                </div>
                <div class="h-9 w-full flex items-center px-3 gap-3 text-text-muted">
                  <div class="w-4 h-4 rounded-full border-2 border-border"></div>
                  <div class="w-14 h-2 bg-border rounded-full"></div>
                </div>
              </div>

              <!-- Lists label -->
              <div class="mt-2 text-[9px] font-bold text-pink uppercase tracking-wider px-1">Lists</div>
              <div class="space-y-1">
                <div class="flex items-center px-3 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-pink"></div>
                  <div class="w-14 h-2 bg-border rounded-full"></div>
                </div>
                <div class="flex items-center px-3 py-1 gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-mint"></div>
                  <div class="w-10 h-2 bg-border rounded-full"></div>
                </div>
              </div>
            </div>

            <!-- Main Content Mockup (Focus View) -->
            <div class="flex-1 bg-white relative flex flex-col items-center justify-center p-6">
              <!-- Clock -->
              <div class="text-center mb-6">
                <div class="text-text font-serif text-5xl md:text-6xl mb-1">09:30</div>
                <div class="text-text-light text-xs font-bold uppercase tracking-widest">Good Morning</div>
              </div>

              <!-- The Task Card -->
              <div class="w-full max-w-xs bg-background border border-border-light p-4 rounded-xl flex items-center gap-4 shadow-sm">
                <div class="w-6 h-6 rounded-lg border-2 border-pink flex-shrink-0"></div>
                <div class="text-lg font-serif text-text">完成产品方案</div>
              </div>

              <!-- Hint -->
              <div class="mt-4 text-pink font-serif text-sm">按 Enter 完成任务</div>
            </div>
          </div>
        </div>

        <!-- Decorative Blobs -->
        <div class="absolute -top-8 -right-8 w-24 h-24 bg-pink-light rounded-full mix-blend-multiply filter blur-2xl opacity-60 animate-pulse-soft"></div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-mint/30 rounded-full mix-blend-multiply filter blur-2xl opacity-60"></div>
      </div>
    </div>
  </header>

  <!-- Section 2: Story -->
  <section id="story" class="snap-section py-20 px-6 bg-white flex items-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif font-medium text-text mb-12 text-center">
        为什么做 First Glance？
      </h2>

      <div class="space-y-6 text-lg text-text-muted leading-relaxed">
        <p>
          我用<span class="text-pink font-medium">滴答清单</span>管理所有任务。
        </p>

        <p>
          我也喜欢 <span class="text-text font-medium">Momentum</span> 那种新标签页——打开就是时钟和今日任务，很清爽。
        </p>

        <p>
          但它有自己的任务系统。用它就得<span class="text-pink font-medium">维护两份数据</span>，或者折腾同步。
        </p>

        <blockquote class="border-l-4 border-pink pl-6 py-2 my-8 bg-pink-bg/30 rounded-r-xl">
          <p class="font-serif text-text">
            我只想在一个地方管任务。
          </p>
        </blockquote>

        <p>
          所以做了 First Glance：<span class="text-text font-medium">直接读滴答清单的数据，不复制，不同步。</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Chill Mode (Dark Background) -->
  <section id="chill-mode" class="snap-section py-20 px-6 bg-text text-background relative overflow-hidden flex items-center">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10 paper-texture"></div>

    <div class="max-w-6xl mx-auto w-full grid md:grid-cols-2 gap-16 items-center relative z-10">
      <!-- Text -->
      <div>
        <div class="w-12 h-12 bg-pink rounded-xl flex items-center justify-center mb-6 text-text">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
          </svg>
        </div>
        <h3 class="text-3xl md:text-4xl font-serif font-bold text-pink mb-4">Chill Mode</h3>
        <p class="text-lg text-background/70 mb-6 leading-relaxed">
          控制不住刷手机？我们帮你。<br/>
          First Glance 会拦截分心网站，用一个「暂停一下」的页面提醒你。
        </p>
        <div class="bg-white/5 p-6 rounded-xl border border-white/10">
          <p class="font-serif text-lg mb-4 text-pink">"真的要现在看这个？"</p>
          <div class="flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-pink">
            <span>长按解锁</span>
            <div class="h-1 flex-1 bg-white/20 rounded-full overflow-hidden">
              <div class="h-full w-1/3 bg-pink transition-all duration-1000"></div>
            </div>
          </div>
          <p class="text-xs text-background/50 mt-3">
            长按 10 秒解锁，暂停屏蔽 15 分钟。足够让你三思而后行。
          </p>
        </div>
      </div>

      <!-- Visual: Blocked Page Mockup -->
      <div class="relative flex justify-center">
        <div class="w-80 bg-background rounded-2xl p-8 text-center text-text shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500">
          <div class="text-5xl font-black mb-4">( ￣^￣ )</div>
          <h4 class="text-2xl font-serif font-bold mb-2">访问已拦截</h4>
          <p class="text-text-muted text-sm mb-8">我是为你好才拦的。</p>

          <button class="w-full py-3 bg-text text-background rounded-full font-bold shadow-lg flex items-center justify-center gap-2 cursor-default">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            好吧，我去专注
          </button>
        </div>

        <!-- Decorative tape -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-20 h-6 tape rounded"></div>
      </div>
    </div>
  </section>

  <!-- Section 5: AI Buddy -->
  <section id="ai-buddy" class="snap-section py-20 px-6 warm-gradient relative overflow-hidden flex items-center">
    <div class="absolute inset-0 paper-texture pointer-events-none opacity-40"></div>

    <div class="max-w-6xl mx-auto w-full grid md:grid-cols-2 gap-16 items-center relative z-10">
      <!-- Left: Text -->
      <div>
        <div class="w-12 h-12 bg-pink-bg rounded-xl flex items-center justify-center mb-6 border border-border-pink">
          <svg class="w-6 h-6 text-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <h3 class="text-3xl md:text-4xl font-serif font-bold text-pink mb-3">AI Buddy</h3>
        <p class="text-lg text-text-muted mb-8 leading-relaxed">根据你的状态，推荐下一步</p>

        <div class="space-y-5">
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-pink-bg rounded-lg flex items-center justify-center flex-shrink-0 border border-border-pink text-pink font-bold text-sm">1</div>
            <div>
              <p class="text-text font-medium">选择心情 kaomoji</p>
              <p class="text-sm text-text-muted">用表情告诉 Buddy 你现在的状态</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-pink-bg rounded-lg flex items-center justify-center flex-shrink-0 border border-border-pink text-pink font-bold text-sm">2</div>
            <div>
              <p class="text-text font-medium">获取个性化任务建议</p>
              <p class="text-sm text-text-muted">基于任务列表和情绪，推荐最适合现在做的事</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-pink-bg rounded-lg flex items-center justify-center flex-shrink-0 border border-border-pink text-pink font-bold text-sm">3</div>
            <div>
              <p class="text-text font-medium">一键调整优先级、拆解子任务</p>
              <p class="text-sm text-text-muted">直接在对话中操作，不打断工作流</p>
            </div>
          </div>
        </div>

        <p class="text-xs text-text-muted mt-8 flex items-center gap-2">
          <svg class="w-4 h-4 text-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          支持任何 OpenAI 兼容 API
        </p>
      </div>

      <!-- Right: BuddyPanel Mockup -->
      <div class="relative flex justify-center">
        <div class="w-80 relative">
          <!-- Mood Selection Panel -->
          <div class="bg-white rounded-2xl shadow-xl border border-border overflow-hidden">
            <!-- Header -->
            <div class="px-5 py-3 border-b border-border-light flex items-center justify-between">
              <span class="font-serif font-bold text-text">AI Buddy</span>
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-lg bg-border-light flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div class="w-6 h-6 rounded-lg bg-border-light flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="p-5">
              <p class="text-center text-text-muted text-sm mb-5">你今天状态怎么样？</p>
              <div class="grid grid-cols-3 gap-3">
                <div class="mood-card">
                  <div class="text-2xl mb-1">(&#x25D5;&#x203F;&#x25D5;)</div>
                  <div class="text-xs text-text-muted font-medium">还不错</div>
                </div>
                <div class="mood-card active">
                  <div class="text-2xl mb-1">[￣_￣]</div>
                  <div class="text-xs text-pink font-medium">一般般</div>
                </div>
                <div class="mood-card">
                  <div class="text-2xl mb-1">(&#xB4;-&#x3C9;-`)</div>
                  <div class="text-xs text-text-muted font-medium">不太好</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Chat Preview (offset, semi-transparent) -->
          <div class="mt-[-8px] ml-4 mr-4 opacity-80">
            <div class="buddy-bubble shadow-md">
              <p class="text-sm text-text leading-relaxed">
                你今天状态一般，不如先从<span class="font-bold">整理会议笔记</span>开始吧...
              </p>
              <div class="flex gap-2 mt-3">
                <span class="px-3 py-1 bg-pink-bg text-pink text-xs font-bold rounded-full border border-border-pink">设为高优先级</span>
                <span class="px-3 py-1 bg-pink-bg text-pink text-xs font-bold rounded-full border border-border-pink">拆解子任务</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Decorative elements -->
        <div class="absolute -top-6 -right-6 w-20 h-20 bg-mint/20 rounded-full mix-blend-multiply filter blur-2xl opacity-60"></div>
        <div class="absolute -top-3 right-4 w-16 h-5 tape rounded"></div>
      </div>
    </div>
  </section>

  <!-- Section 6: Make It Yours -->
  <section id="make-it-yours" class="snap-section py-20 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-serif font-medium text-text mb-3">定制你的体验</h2>
        <p class="text-text-muted text-lg">选择主题、连接工具，或直接开始</p>
      </div>

      <!-- Theme Gallery -->
      <div class="mb-16">
        <h3 class="text-lg font-serif font-bold text-text mb-6 text-center">5 种精心设计的主题</h3>
        <div class="theme-scroll justify-center">
          {themes.map((theme) => (
            <div class="w-44 flex-shrink-0">
              <!-- Mini browser mockup -->
              <div class="rounded-xl overflow-hidden border border-border shadow-md hover:shadow-lg transition-shadow">
                <!-- Browser bar -->
                <div class="h-5 flex items-center gap-1.5 px-2" style={`background-color: ${theme.accent}`}>
                  <div class="w-2 h-2 rounded-full" style={`background-color: ${theme.text}; opacity: 0.3`}></div>
                  <div class="w-2 h-2 rounded-full" style={`background-color: ${theme.text}; opacity: 0.3`}></div>
                  <div class="w-2 h-2 rounded-full" style={`background-color: ${theme.text}; opacity: 0.3`}></div>
                </div>
                <!-- Content -->
                <div class="p-4 text-center" style={`background-color: ${theme.bg}`}>
                  <div class="font-serif text-xl font-medium mb-2" style={`color: ${theme.text}`}>09:30</div>
                  <div class="mx-auto w-24 h-6 rounded-lg flex items-center gap-2 px-2" style={`background-color: ${theme.accent}`}>
                    <div class="w-3 h-3 rounded border-2 flex-shrink-0" style={`border-color: ${theme.pink}`}></div>
                    <div class="flex-1 h-1.5 rounded-full" style={`background-color: ${theme.text}; opacity: 0.2`}></div>
                  </div>
                </div>
              </div>
              <!-- Theme name + dot -->
              <div class="flex items-center justify-center gap-2 mt-2">
                <div class="w-3 h-3 rounded-full border border-border" style={`background-color: ${theme.pink}`}></div>
                <span class="text-sm text-text-muted font-medium">{theme.name}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Integrations Bar -->
      <div class="mb-12">
        <h3 class="text-lg font-serif font-bold text-text mb-6 text-center">集成你的任务工具</h3>
        <div class="flex flex-wrap justify-center gap-4">
          {integrations.map((item) => (
            <div class={`flex items-center gap-3 px-5 py-3 rounded-xl border ${
              item.status === 'supported'
                ? 'bg-background border-border'
                : 'bg-background/60 border-dashed border-border'
            }`}>
              {item.logo ? (
                <img src={item.logo} alt={item.name.zh} class="w-5 h-5" />
              ) : (
                <span class={`text-lg ${item.status === 'planned' ? 'opacity-50' : ''}`}>{item.icon}</span>
              )}
              <span class="text-sm font-bold text-text">{item.name.zh}</span>
              <span class={`px-2 py-0.5 text-xs font-bold rounded-full ${
                item.status === 'supported'
                  ? 'bg-mint/20 text-mint border border-mint/30'
                  : 'bg-border-light text-text-muted border border-border'
              }`}>
                {item.status === 'supported' ? '✓' : '计划中'}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Guest Mode Callout -->
      <div class="max-w-2xl mx-auto bg-border-light/50 border border-border rounded-xl px-6 py-4 flex items-center gap-4">
        <div class="w-10 h-10 bg-background rounded-full flex items-center justify-center flex-shrink-0 border border-border">
          <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">
          <span class="text-text font-medium">没有账号？没关系。</span>游客模式支持最多 3 个本地任务，无需登录即可体验。
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-white border-t border-border py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2 opacity-50">
        <div class="w-5 h-5 rounded-full border border-current flex items-center justify-center">
          <div class="w-1.5 h-1.5 bg-current rounded-full"></div>
        </div>
        <span class="font-serif font-bold text-sm text-text">First Glance</span>
      </div>

      <div class="flex gap-6 text-sm font-medium opacity-60">
        <a href="https://github.com/gwifloria/first-glance/issues" target="_blank" class="hover:opacity-100 transition-opacity">GitHub</a>
        <a href="https://t.me/firstglance_community" target="_blank" class="hover:opacity-100 transition-opacity">Telegram</a>
        <a href="/first-glance/privacy" class="hover:opacity-100 transition-opacity">隐私政策</a>
        <a href="https://buymeacoffee.com/gwifloria" target="_blank" class="hover:opacity-100 transition-opacity">Buy me a coffee</a>
      </div>

      <div class="text-xs font-bold uppercase tracking-widest text-text/40">
        &copy; 2025 Wonderland
      </div>
    </div>
  </footer>
</Layout>
