  <script>
    const sections = ['hero', 'planner', 'focus', 'ai-buddy', 'make-it-yours'];
    const darkSections = ['focus'];
    const dots = document.querySelectorAll('.dot-nav');

    function updateNav() {
      const scrollY = window.scrollY;
      const activeY = scrollY + window.innerHeight / 3;
      const darkY = scrollY + window.innerHeight / 2;

      let current = sections[0];
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el && el.offsetTop <= activeY) current = id;
      }

      let isOnDark = false;
      for (const id of darkSections) {
        const el = document.getElementById(id);
        if (el && darkY >= el.offsetTop && darkY <= el.offsetTop + el.offsetHeight) {
          isOnDark = true;
          break;
        }
      }

      dots.forEach(dot => {
        const indicator = dot.querySelector('.dot-indicator');
        const label = dot.querySelector('span:first-child');
        const isActive = dot.getAttribute('data-section') === current;

        if (indicator) {
          if (isActive) {
            indicator.classList.add('!bg-tape-pink', '!scale-150', '!border-tape-pink');
          } else {
            indicator.classList.remove('!bg-tape-pink', '!scale-150', '!border-tape-pink');
            indicator.style.backgroundColor = isOnDark ? 'rgba(249,245,235,0.3)' : '';
            indicator.style.borderColor = isOnDark ? 'rgba(249,245,235,0.2)' : '';
          }
        }
        if (label) {
          if (isOnDark) {
            label.classList.add('!bg-ink/80', '!text-cream');
            label.classList.remove('!bg-white/90', '!text-ink');
          } else {
            label.classList.remove('!bg-ink/80', '!text-cream');
          }
        }
      });
    }

    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();
  </script>
