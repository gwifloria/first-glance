---
import Layout from '../layouts/Layout.astro'
---

<Layout title="安装成功 - First Glance">
  <!-- Background Texture -->
  <div class="fixed inset-0 paper-texture pointer-events-none z-0"></div>

  <!-- Hero Section -->
  <header class="relative pt-24 pb-16 px-6 z-10">
    <div class="max-w-3xl mx-auto text-center">
      <!-- Success Badge -->
      <div
        class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-sage-dark bg-sage/50 mb-8 backdrop-blur-sm"
      >
        <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm font-bold tracking-wide">安装成功</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-hand font-medium mb-6 leading-tight text-stone">
        First Glance<br />
        <span class="opacity-70">已准备就绪</span>
      </h1>

      <p class="text-lg md:text-xl opacity-70 max-w-xl mx-auto mb-10 leading-relaxed">
        每次打开新标签页，都是专注的开始。<br class="hidden md:block" />
        让我们开始吧。
      </p>

      <a
        href="chrome://newtab"
        onclick="window.close()"
        class="inline-flex items-center gap-3 px-8 py-4 bg-stone text-cream-light rounded-lg font-bold shadow-xl hover:-translate-y-1 transition-transform"
      >
        打开新标签页体验
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </header>

  <!-- Features Section -->
  <section class="py-16 px-6 max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-hand font-medium text-stone mb-3">核心功能</h2>
      <p class="text-stone-light">专为专注设计的新标签页</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Feature 1: 专注视图 -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-cream-dark hover:shadow-md transition-shadow group">
        <div class="w-11 h-11 bg-cream rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold font-hand mb-2 text-stone">保持专注</h3>
        <p class="text-sm opacity-70 leading-relaxed">
          简洁的时钟和今日任务，每次打开新标签页都是专注的开始。
        </p>
      </div>

      <!-- Feature 2: 任务管理 -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-cream-dark hover:shadow-md transition-shadow group">
        <div class="w-11 h-11 bg-cream rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
        </div>
        <h3 class="text-lg font-bold font-hand mb-2 text-stone">掌控任务</h3>
        <p class="text-sm opacity-70 leading-relaxed">
          快速查看、添加、完成任务，支持同步滴答清单。
        </p>
      </div>

      <!-- Feature 3: 网站屏蔽 -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-cream-dark hover:shadow-md transition-shadow group">
        <div class="w-11 h-11 bg-cream rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        </div>
        <h3 class="text-lg font-bold font-hand mb-2 text-stone">远离干扰</h3>
        <p class="text-sm opacity-70 leading-relaxed">
          屏蔽分心网站，需要时长按解锁 15 分钟。
        </p>
      </div>

      <!-- Feature 4: 主题切换 -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-cream-dark hover:shadow-md transition-shadow group">
        <div class="w-11 h-11 bg-cream rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <h3 class="text-lg font-bold font-hand mb-2 text-stone">个性风格</h3>
        <p class="text-sm opacity-70 leading-relaxed">
          5 种精心设计的主题，总有一款适合你。
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Start Section -->
  <section class="py-16 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-sage/30 -skew-y-2 transform scale-110 z-0"></div>
    <div class="relative z-10 max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-hand font-medium text-stone mb-3">快速开始</h2>
        <p class="text-stone-light">选择适合你的方式</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Guest Mode -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-cream-dark">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-cream rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold font-hand text-stone">游客模式</h3>
          </div>
          <p class="text-sm opacity-70 leading-relaxed mb-4">
            无需登录，直接使用。数据保存在本地，最多创建 3 个任务。适合快速体验。
          </p>
          <div class="text-xs text-stone-light">
            打开新标签页即可开始使用
          </div>
        </div>

        <!-- TickTick Connection -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-cream-dark">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-sage rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            </div>
            <h3 class="text-lg font-bold font-hand text-stone">连接滴答清单</h3>
          </div>
          <p class="text-sm opacity-70 leading-relaxed mb-4">
            同步你的所有任务和项目。在新标签页管理任务，自动同步到滴答清单。
          </p>
          <div class="text-xs text-stone-light">
            在设置中连接你的滴答清单账号
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-white border-t border-cream-dark py-10 px-6">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2 opacity-50">
        <div class="w-5 h-5 rounded-full border border-current flex items-center justify-center">
          <div class="w-1.5 h-1.5 bg-current rounded-full"></div>
        </div>
        <span class="font-hand font-bold text-sm">First Glance</span>
      </div>

      <div class="flex gap-6 text-sm font-medium opacity-60">
        <a href="https://github.com/anthropics/first-glance/issues" class="hover:opacity-100 transition-opacity">反馈</a>
        <a href="https://github.com/anthropics/first-glance" class="hover:opacity-100 transition-opacity">GitHub</a>
        <a href="/privacy" class="hover:opacity-100 transition-opacity">隐私政策</a>
      </div>
    </div>
  </footer>
</Layout>
